# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real credentials.

PORT=3000

# Local Postgres (docker container). SSL is disabled automatically for
# localhost by config/database.js:
#   docker run -d --name aris-db -e POSTGRES_PASSWORD=aris -e POSTGRES_DB=aris \
#     -p 5432:5432 -v aris-pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL=postgresql://postgres:aris@localhost:5432/aris

# For a hosted database (Supabase, Neon, RDS) SSL is enabled automatically.
# Override with DATABASE_SSL=true|false if the detection is wrong.
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

PYTHON_SERVICE_URL=http://localhost:8000

# ─── Email ────────────────────────────────────────────────────────────
#
# Managed hosts block outbound SMTP. On Render, POST /api/auth/forgot-password
# hung for 120 seconds and returned 502 with Gmail SMTP configured, because the
# connection never completes. Set one of the HTTPS API keys below when
# deploying; they are ordinary requests to port 443 and are never blocked.
#
# Brevo is the easier of the two: the free tier sends 300 emails a day and you
# can verify a plain Gmail address as the sender, so you do not need to own a
# domain. Resend requires a verified domain before it will send to anyone but
# yourself.
#
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
#
# SMTP below is the fallback and works fine for local development.

# Project Gmail account and a 16-character App Password (NOT the login
# password). Create one at https://myaccount.google.com/apppasswords while
# signed in as this same account.
#
# Use a dedicated project mailbox, not anyone's personal address — every
# candidate notification and reset code is sent from here.
SMTP_USER=your_project_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Display name recipients see next to the address. Optional.
SMTP_FROM_NAME=ResumeMatch AI

# ─── Deployment only (leave unset for local development) ───────────────

# Comma separated list of browser origins allowed to call this API.
# Unset means allow all, which is what local development wants.
# CORS_ORIGINS=https://your-project.vercel.app

# Set to 1 behind a reverse proxy (Vercel, Render, Railway, nginx). Without
# it express-rate-limit sees the proxy's IP for every visitor and buckets
# them all together, so one user's traffic locks out everyone else.
# Do NOT set it when running without a proxy: it would let anyone spoof
# X-Forwarded-For and bypass the limiter entirely.
# TRUST_PROXY=1
